# OpenNovel 配置示例
# 复制为 .env 后按你的需求填写：cp .env.example .env
# CLI 启动时自动加载 .env（python-dotenv），无需手动 export

# ===== LLM 基础 =====

# API 密钥（必填；或设置 OPENAI_API_KEY）
OPENNOVEL_LLM_API_KEY=sk-xxx

# 模型名（必填，按服务商填）
#  DeepSeek:     deepseek-chat
#  通义千问:      qwen-plus
#  智谱 GLM:     glm-4-plus
#  OpenAI:       gpt-4o-mini
OPENNOVEL_LLM_MODEL=deepseek-chat

# 服务地址（可选；不设置则使用 OpenAI 官方端点）
#  DeepSeek:  https://api.deepseek.com/v1
#  通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#  智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#  Moonshot:  https://api.moonshot.cn/v1
OPENNOVEL_LLM_BASE_URL=https://api.deepseek.com/v1

# ===== LLM 生成参数 =====

# 采样温度（默认 0.7；写正文可调高到 0.9 更富变化，规划大纲可调低到 0.3 更稳定）
OPENNOVEL_LLM_TEMPERATURE=0.7

# 单次调用最大 token 数（默认 4096；注意推理模型会先消耗一部分做思考，需留余量）
OPENNOVEL_LLM_MAX_TOKENS=4096

# ===== 小说生成参数（编排层使用）=====

# 成书语言（默认 zh，中文小说）
OPENNOVEL_LANGUAGE=zh

# 每章目标字数（默认 3000；长章节调大）
OPENNOVEL_CHAPTER_TARGET_CHARS=3000

# 最大章节数（默认 20，防止剧情过长失控）
OPENNOVEL_MAX_CHAPTERS=20

# 成书输出目录（默认 novels，每本书一个 novels/<title>/novel.json）
OPENNOVEL_OUTPUT_DIR=novels
