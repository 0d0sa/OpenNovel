# OpenNovel LLM 配置示例
# 复制为 .env 后按你的服务商填写：cp .env.example .env
# 注意：目前 CLI 不会自动加载 .env，需要手动导出（见下方命令）

# API 密钥（必填；或设置 OPENAI_API_KEY）
OPENNOVEL_LLM_API_KEY=sk-xxx

# 模型名（必填，按服务商填）
#  DeepSeek:     deepseek-chat
#  通义千问:      qwen-plus
#  智谱 GLM:     glm-4-plus
#  OpenAI:       gpt-4o-mini
OPENNOVEL_LLM_MODEL=deepseek-chat

# 服务地址（可选；不设置则使用 OpenAI 官方端点）
#  DeepSeek:  https://api.deepseek.com/v1
#  通义千问:   https://dashscope.aliyuncs.com/compatible-mode/v1
#  智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
#  Moonshot:  https://api.moonshot.cn/v1
OPENNOVEL_LLM_BASE_URL=https://api.deepseek.com/v1

# 使用示例（当前需手动导出，尚未支持自动加载 .env）
#   source .env
#   uv run opennovel
